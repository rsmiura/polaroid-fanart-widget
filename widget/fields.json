{
  "polaroidCount": {
    "type": "slider",
    "label": "Polaroids on screen",
    "value": 1,
    "min": 1,
    "max": 6,
    "step": 1,
    "group": "Look & behavior"
  },
  "randomSinglePosition": {
    "type": "checkbox",
    "label": "Single polaroid: land in a random spot",
    "value": false,
    "group": "Look & behavior"
  },
  "maxOverlap": {
    "type": "slider",
    "label": "Max overlap between polaroids (%)",
    "value": 0,
    "min": 0,
    "max": 100,
    "step": 5,
    "group": "Look & behavior"
  },
  "polaroidWidth": {
    "type": "number",
    "label": "Polaroid width (px)",
    "value": 360,
    "min": 200,
    "max": 800,
    "step": 10,
    "group": "Look & behavior"
  },
  "maxPhotoHeight": {
    "type": "number",
    "label": "Max photo height (px)",
    "value": 480,
    "min": 200,
    "max": 1000,
    "step": 10,
    "group": "Look & behavior"
  },
  "rotationSeconds": {
    "type": "number",
    "label": "Seconds per artwork",
    "value": 20,
    "min": 5,
    "max": 600,
    "step": 1,
    "group": "Look & behavior"
  },
  "transitionSeconds": {
    "type": "number",
    "label": "Transition length (seconds)",
    "value": 1.2,
    "min": 0.3,
    "max": 4,
    "step": 0.1,
    "group": "Look & behavior"
  },
  "orderMode": {
    "type": "dropdown",
    "label": "Order",
    "value": "shuffle",
    "options": {
      "shuffle": "Shuffle (no repeats per cycle)",
      "slots": "Slot order"
    },
    "group": "Look & behavior"
  },
  "replaceMode": {
    "type": "dropdown",
    "label": "Which polaroid changes",
    "value": "oldest",
    "options": {
      "oldest": "Oldest first",
      "random": "Random"
    },
    "group": "Look & behavior"
  },
  "maxTilt": {
    "type": "slider",
    "label": "Max tilt (degrees)",
    "value": 6,
    "min": 0,
    "max": 20,
    "step": 1,
    "group": "Look & behavior"
  },
  "frameColor": {
    "type": "colorpicker",
    "label": "Frame color",
    "value": "#fdfdf8",
    "group": "Look & behavior"
  },
  "captionFont": {
    "type": "googleFont",
    "label": "Caption font",
    "value": "Caveat",
    "group": "Look & behavior"
  },
  "captionColor": {
    "type": "colorpicker",
    "label": "Caption text color",
    "value": "#2b2b2b",
    "group": "Look & behavior"
  },
  "showHandle": {
    "type": "checkbox",
    "label": "Show artist handle",
    "value": true,
    "group": "Look & behavior"
  },
  "creditPrefix": {
    "type": "text",
    "label": "Text before artist name (empty = none)",
    "value": "art by",
    "group": "Look & behavior"
  },
  "pinStyle": {
    "type": "dropdown",
    "label": "Pin style",
    "value": "pushpin",
    "options": {
      "pushpin": "Pushpin",
      "tape": "Tape",
      "none": "None"
    },
    "group": "Look & behavior"
  },
  "pinColor": {
    "type": "colorpicker",
    "label": "Pushpin color",
    "value": "#d7263d",
    "group": "Look & behavior"
  },
  "shadowStrength": {
    "type": "slider",
    "label": "Shadow strength",
    "value": 60,
    "min": 0,
    "max": 100,
    "step": 5,
    "group": "Look & behavior"
  },
  "debugPanel": {
    "type": "checkbox",
    "label": "Show debug panel (for troubleshooting)",
    "value": false,
    "group": "Look & behavior"
  },
